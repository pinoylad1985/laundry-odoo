<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        A full-width band at the TOP of the control panel, above the breadcrumb and
        the search bar. The control panel has no slot up there, so one is added here.

        This is a global extension - it touches every control panel in the backend -
        but all it adds is a `t-slot` nobody fills. OWL renders an unprovided slot as
        nothing, so every other view is byte-identical to before; the band exists only
        where a view sets the slot, which today is Orders Pending and nothing else.
    -->
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_main')]" position="before">
            <t t-slot="control-panel-laundry-band"/>
        </xpath>
    </t>

    <!--
        Orders Pending: the service buttons. They started in `layout-buttons`, which
        is the strip beside New - too narrow for six services, so they wrapped onto a
        second line and squeezed the breadcrumb down to "Orders ...". They get a row
        of their own instead, through the slot above.

        The markup is the shape of a form view's stat buttons (icon, then label over
        number) but with classes of our own rather than `oe_stat_button`: core styles
        those through `.oe_button_box > ...` descendant selectors that exist only
        inside a form, so reusing the name out here would inherit half a look.
        backend.scss draws the whole thing instead.
    -->
    <t t-name="laundry_pos.PendingListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='layout-actions']" position="before">
            <t t-set-slot="control-panel-laundry-band">
                <div class="laundry-pending-services" role="group" aria-label="Service">
                    <button type="button"
                            t-attf-class="laundry-pending-stat {{ laundryAllActive ? 'active' : '' }}"
                            t-on-click="() => this.clearLaundryServices()">
                        <i class="fa fa-th-list laundry-pending-stat-icon" aria-hidden="true"/>
                        <span class="laundry-pending-stat-info">
                            <span class="laundry-pending-stat-text">All</span>
                            <span class="laundry-pending-stat-value" t-esc="laundryCounts.total"/>
                        </span>
                    </button>
                    <button t-foreach="laundryServiceFilters" t-as="svc" t-key="svc.id"
                            type="button"
                            t-attf-class="laundry-pending-stat {{ svc.isActive ? 'active' : '' }}"
                            t-on-click="() => this.toggleLaundryService(svc)">
                        <i t-attf-class="fa {{ laundryIconFor(svc) }} laundry-pending-stat-icon"
                           aria-hidden="true"/>
                        <span class="laundry-pending-stat-info">
                            <span class="laundry-pending-stat-text" t-esc="svc.description"/>
                            <span class="laundry-pending-stat-value" t-esc="laundryCountFor(svc)"/>
                        </span>
                    </button>
                </div>
            </t>
        </xpath>
    </t>

</templates>
