<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--
        One numpad key that scrolls. The outer key stays put (it carries the centre
        band and the selected colour) and only the inner list moves. Two things mark
        the selection: the key goes solid primary, and the chosen row is the only one
        that isn't greyed and blurred.
    -->
    <t t-name="laundry_pos.DateWheel">
        <div class="btn numpad-button position-relative rounded-0 border-0 laundry-wheel"
             t-att-class="isActive ? 'btn-primary' : 'btn-secondary'">
            <div class="laundry-wheel-list" t-ref="list" t-on-scroll="onScroll">
                <div t-foreach="dates" t-as="d" t-key="d.value"
                     class="laundry-wheel-item fs-5"
                     t-att-class="d.value === props.value ? 'laundry-wheel-item-active' : 'laundry-wheel-item-idle'"
                     t-on-click="() => this.pick(d_index)">
                    <t t-esc="d.label"/>
                    <span t-if="d.note" class="small ms-1" t-esc="d.note"/>
                </div>
            </div>
        </div>
    </t>
</templates>
