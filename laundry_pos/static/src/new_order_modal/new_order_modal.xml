<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="laundry_pos.NewOrderModal">
        <Dialog title="'New Laundry Order'" size="'lg'" contentClass="'laundry-touch laundry-neworder'">

            <!-- ① Who is this order for? -->
            <section class="mb-4">
                <p class="fw-semibold text-muted mb-2">1. Who is this order for?</p>
                <div class="laundry-grid laundry-grid-2">
                    <button t-foreach="customerTypes" t-as="ct" t-key="ct.code"
                            type="button"
                            class="btn numpad-button position-relative rounded-0 border-0 fs-5"
                            t-att-class="state.customerType === ct.code ? 'btn-primary' : 'btn-secondary ' + ct.color"
                            t-on-click="() => this.selectCustomerType(ct.code)">
                        <t t-esc="ct.label"/>
                    </button>
                </div>

                <!-- Returning customer inline search -->
                <div t-if="state.customerType === 'returning'" class="mt-3">
                    <input type="text"
                           class="form-control form-control-lg"
                           placeholder="Search by name, phone, or address… (press Enter to search all)"
                           t-att-value="state.partnerQuery"
                           t-on-input="onSearchInput"
                           t-on-keydown="onSearchKeydown"
                           autofocus="autofocus"/>

                    <!-- Selected customer card -->
                    <div t-if="state.selectedPartner"
                         class="mt-2 p-3 border rounded d-flex align-items-start gap-3"
                         style="background:#f0fdf4;border-color:#86efac !important;">
                        <div class="flex-grow-1">
                            <div class="fw-bold fs-6" t-esc="state.selectedPartner.name"/>
                            <div t-if="state.selectedPartner.phone || state.selectedPartner.mobile"
                                 class="text-muted small mt-1">
                                <t t-esc="state.selectedPartner.phone || state.selectedPartner.mobile"/>
                            </div>
                            <div t-if="partnerAddress(state.selectedPartner)"
                                 class="text-muted small">
                                <t t-esc="partnerAddress(state.selectedPartner)"/>
                            </div>
                        </div>
                        <button class="btn btn-outline-secondary flex-shrink-0"
                                t-on-click="() => this.unselectPartner()">
                            Unselect
                        </button>
                    </div>

                    <!-- Search results — taller now that each row carries a double-height button. -->
                    <div t-if="filteredPartners.length" class="mt-2 border rounded overflow-auto" style="max-height:320px;">
                        <div t-foreach="filteredPartners" t-as="partner" t-key="partner.id"
                             class="d-flex align-items-start gap-3 px-3 py-3 border-bottom">
                            <div class="flex-grow-1" t-on-click="() => this.pickPartner(partner)" style="cursor:pointer;">
                                <div class="fw-semibold fs-6" t-esc="partner.name"/>
                                <div t-if="partner.phone || partner.mobile" class="text-muted small mt-1">
                                    <t t-esc="partner.phone || partner.mobile"/>
                                </div>
                                <div t-if="partnerAddress(partner)" class="text-muted small">
                                    <t t-esc="partnerAddress(partner)"/>
                                </div>
                                <div t-if="partnerTags(partner).length" class="mt-1 d-flex flex-wrap gap-1">
                                    <span t-foreach="partnerTags(partner)" t-as="tag" t-key="tag_index"
                                          class="badge text-bg-secondary fw-normal">
                                        <t t-esc="tag"/>
                                    </span>
                                </div>
                            </div>
                            <button class="btn btn-outline-primary flex-shrink-0 mt-1"
                                    t-on-click="(ev) => { ev.stopPropagation(); this.editPartner(partner); }">
                                Edit Details
                            </button>
                        </div>
                    </div>

                    <div t-if="showNoResults" class="mt-2 text-muted small text-center py-2">
                        No customers found
                    </div>
                </div>
            </section>

            <!-- ② Select Service Type (appears after customer type chosen) -->
            <section t-if="state.customerType" class="mb-4">
                <p class="fw-semibold text-muted mb-2">2. Select Service Type</p>
                <!-- 2 columns; an odd last one (Self-service) spans the full width. -->
                <div class="laundry-grid laundry-grid-2">
                    <button t-foreach="serviceTypes" t-as="st" t-key="st.code"
                            type="button"
                            class="btn numpad-button position-relative rounded-0 border-0 fs-5"
                            t-att-class="(state.serviceType === st.code ? 'btn-primary' : 'btn-secondary ' + st.color) + (st_index === serviceTypes.length - 1 and serviceTypes.length % 2 ? ' laundry-span-2' : '')"
                            t-on-click="() => this.selectServiceType(st.code)">
                        <t t-esc="st.label"/>
                    </button>
                </div>
            </section>

            <!-- ③ Services: each pill adds the product to the main POS order -->
            <section t-if="state.serviceType" class="mb-4">
                <p class="fw-semibold text-muted mb-2">3. Services</p>
                <p t-if="servicesDisabled" class="text-muted small fst-italic mb-2">Not required for self-service.</p>
                <div class="row g-2">
                    <div t-foreach="services" t-as="svc" t-key="svc.code" class="col-6">
                        <div class="d-flex flex-wrap align-items-center gap-2 p-2 border rounded h-100"
                             t-att-class="(serviceCount(svc.code) ? 'bg-primary text-white border-primary' : 'border-secondary-subtle') + (servicesDisabled ? ' opacity-50' : '')">
                            <span class="fw-semibold fs-6" t-esc="svc.label"/>
                            <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                                <button type="button"
                                        class="btn numpad-button position-relative border-0 btn-secondary o_colorlist_item_numpad_color_1 fw-bold fs-4 laundry-step-btn"
                                        t-att-disabled="servicesDisabled || !serviceCount(svc.code)"
                                        t-on-click="() => this.removeService(svc.code)">−</button>
                                <span class="fw-bold text-center fs-5" style="min-width:1.75rem;"
                                      t-esc="serviceCount(svc.code)"/>
                                <button type="button"
                                        class="btn numpad-button position-relative border-0 btn-secondary o_colorlist_item_numpad_color_10 fw-bold fs-4 laundry-step-btn"
                                        t-att-disabled="servicesDisabled"
                                        t-on-click="() => this.addService(svc.code)">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ④ Schedule + Turnaround (appears after items added, not for self_service) -->
            <section t-if="hasAnyService and state.serviceType !== 'self_service'" class="mb-2">
                <p class="fw-semibold text-muted mb-3">4. Schedule</p>

                <!-- Drop-off: Claim date/time (6 AM – 3 AM) -->
                <div t-if="state.serviceType === 'dropoff'" class="mb-3">
                    <label class="form-label fw-semibold small text-muted">
                        Claim Date &amp; Time <span class="text-danger">*</span>
                    </label>
                    <t t-call="laundry_pos.QuickDates">
                        <t t-set="field" t-value="'claimDate'"/>
                        <t t-set="selectedDate" t-value="state.claimDate"/>
                    </t>
                    <t t-call="laundry_pos.HourPills">
                        <t t-set="kind" t-value="'claim'"/>
                        <t t-set="field" t-value="'claimHour'"/>
                        <t t-set="selected" t-value="state.claimHour"/>
                        <t t-set="dateVal" t-value="state.claimDate"/>
                    </t>
                </div>

                <!-- Drop-off &amp; Delivery: Delivery date/time -->
                <div t-if="state.serviceType === 'dropoff_delivery'" class="mb-3">
                    <label class="form-label fw-semibold small text-muted">
                        Delivery Date &amp; Time <span class="text-danger">*</span>
                    </label>
                    <t t-call="laundry_pos.QuickDates">
                        <t t-set="field" t-value="'deliveryDate'"/>
                        <t t-set="selectedDate" t-value="state.deliveryDate"/>
                    </t>
                    <t t-call="laundry_pos.HourPills">
                        <t t-set="kind" t-value="'delivery'"/>
                        <t t-set="field" t-value="'deliveryHour'"/>
                        <t t-set="selected" t-value="state.deliveryHour"/>
                        <t t-set="dateVal" t-value="state.deliveryDate"/>
                    </t>
                </div>

                <!-- Pickup &amp; Delivery / Locker: Pickup + Delivery -->
                <t t-if="state.serviceType === 'pickup_delivery' || state.serviceType === 'locker'">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">
                            Pickup Date &amp; Time <span class="text-danger">*</span>
                        </label>
                        <t t-call="laundry_pos.QuickDates">
                            <t t-set="field" t-value="'pickupDate'"/>
                            <t t-set="selectedDate" t-value="state.pickupDate"/>
                        </t>
                        <t t-call="laundry_pos.HourPills">
                            <t t-set="kind" t-value="'pickup'"/>
                            <t t-set="field" t-value="'pickupHour'"/>
                            <t t-set="selected" t-value="state.pickupHour"/>
                            <t t-set="dateVal" t-value="state.pickupDate"/>
                        </t>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">
                            Delivery Date &amp; Time <span class="text-danger">*</span>
                        </label>
                        <t t-call="laundry_pos.QuickDates">
                            <t t-set="field" t-value="'pdDelDate'"/>
                            <t t-set="selectedDate" t-value="state.pdDelDate"/>
                        </t>
                        <t t-call="laundry_pos.HourPills">
                            <t t-set="kind" t-value="'delivery'"/>
                            <t t-set="field" t-value="'pdDelHour'"/>
                            <t t-set="selected" t-value="state.pdDelHour"/>
                            <t t-set="dateVal" t-value="state.pdDelDate"/>
                        </t>
                    </div>
                </t>

                <!-- Turnaround pills (auto-calculated, display only) -->
                <p class="fw-semibold text-muted mb-2 mt-3">Turnaround</p>
                <div class="d-flex gap-2">
                    <div class="flex-fill py-3 px-3 rounded border text-center"
                         t-att-class="turnaroundType === 'express' ? 'bg-primary text-white border-primary' : 'bg-light text-muted'">
                        <div class="fw-bold">⚡ Express</div>
                        <div class="small mt-1" t-esc="expressLabel"/>
                    </div>
                    <div class="flex-fill py-3 px-3 rounded border text-center"
                         t-att-class="turnaroundType === 'regular' ? 'bg-primary text-white border-primary' : 'bg-light text-muted'">
                        <div class="fw-bold">🕐 Regular</div>
                        <div class="small mt-1" t-esc="regularLabel"/>
                    </div>
                </div>
                <div t-if="turnaroundError" class="mt-2 text-danger small fw-semibold" t-esc="turnaroundError"/>
            </section>

            <t t-set-slot="footer">
                <button class="btn btn-light me-auto" t-on-click="skip">
                    Skip for now
                </button>
                <button class="btn btn-primary px-4"
                        t-att-disabled="!canConfirm"
                        t-on-click="confirm">
                    Continue →
                </button>
            </t>

        </Dialog>
    </t>

    <!--
        Reusable date row — the 3 quick dates + the 📅 picker as one 4-up numpad block.
        Caller sets: field (the state key), selectedDate (its current value).
    -->
    <t t-name="laundry_pos.QuickDates">
        <div class="laundry-grid laundry-grid-4 mb-2">
            <button t-foreach="quickDates" t-as="qd" t-key="qd.value"
                    type="button"
                    class="btn numpad-button position-relative rounded-0 border-0 fs-5"
                    t-att-class="selectedDate === qd.value ? 'btn-primary' : 'btn-secondary o_colorlist_item_numpad_color_3'"
                    t-on-click="() => this.setDate(field, qd.value)">
                <t t-esc="qd.label"/>
            </button>
            <!-- The cell holds an invisible native date input stretched over the button. -->
            <div class="position-relative laundry-date-cell">
                <button type="button"
                        class="btn numpad-button position-relative rounded-0 border-0 laundry-date-pick"
                        t-att-class="isCustomDate(selectedDate) ? 'btn-primary' : 'btn-secondary o_colorlist_item_numpad_color_6'">
                    📅<span t-if="isCustomDate(selectedDate)" class="ms-1 small"><t t-esc="fmtPickedDate(selectedDate)"/></span>
                </button>
                <input type="date" class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                       style="cursor:pointer;"
                       t-att-value="selectedDate"
                       t-on-change="(ev) => this.setDate(field, ev.target.value)"/>
            </div>
        </div>
    </t>

    <!--
        Reusable hour picker — 24 pills as 4 columns of 6, filled DOWN each column
        (12 AM–5 AM, 6 AM–11 AM, 12 PM–5 PM, 6 PM–11 PM), tinted by time of day.
        Caller sets: kind ('claim'|'pickup'|'delivery'), field (state key), selected, dateVal.
    -->
    <t t-name="laundry_pos.HourPills">
        <div class="laundry-grid laundry-grid-hours">
            <button t-foreach="hours" t-as="hr" t-key="hr.value"
                    type="button"
                    class="btn numpad-button position-relative rounded-0 border-0 fs-5"
                    t-att-disabled="isHourDisabled(kind, hr.h, dateVal)"
                    t-att-class="isHourDisabled(kind, hr.h, dateVal) ? 'btn-secondary text-muted' : (selected === hr.value ? 'btn-primary' : 'btn-secondary ' + hr.color)"
                    t-on-click="() => this.setHour(field, hr.value)">
                <t t-esc="hr.label"/>
            </button>
        </div>
    </t>
</templates>
