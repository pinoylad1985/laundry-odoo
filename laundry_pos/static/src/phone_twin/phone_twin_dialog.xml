<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="laundry_pos.PhoneTwinDialog">
        <Dialog title="'Duplicate phone number'" size="'md'">
            <div>This phone number is already used by:</div>
            <div class="my-2 p-2 border rounded-3">
                <div t-foreach="props.lines" t-as="line" t-key="line_index"
                     t-att-class="line_index == 0 ? 'fs-5 fw-bold' : 'text-muted'">
                    <t t-esc="line"/>
                </div>
            </div>
            <!-- An archived contact is one somebody deliberately took out of
                 the book, so it is not offered for use with one tap - it has
                 to be restored first, by whoever can see why it was archived.
                 Said rather than hidden: an archived twin is invisible to the
                 cashier's search, which is exactly how a second record for
                 somebody already in the book gets made. -->
            <div t-if="props.archived" class="text-danger mb-2">
                That contact is archived. Restore it before using it.
            </div>
            <div t-if="canConfirm">Click <b>Confirm</b> to <t t-esc="props.confirmHint"/></div>
            <div>Click <b>Cancel</b> to <t t-esc="props.cancelHint"/></div>
            <t t-set-slot="footer">
                <button t-if="canConfirm" class="btn btn-primary"
                        t-on-click="() => this.choose('confirm')">Confirm</button>
                <button class="btn btn-secondary"
                        t-on-click="() => this.choose('cancel')">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
