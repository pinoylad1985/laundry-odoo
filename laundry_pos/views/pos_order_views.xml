<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        POS Orders LIST: append the laundry_* columns (display only — editing is done on
        the form). We can't hide the Studio x_studio_* columns from a module view
        (xpath-targeting Studio-added columns fails validation) — hide them via the ⚙
        column picker or the Studio view.
    -->
    <record id="view_pos_order_tree_laundry" model="ir.ui.view">
        <field name="name">pos.order.list.laundry</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <!-- Make the core "Customer" column (partner_id) optional so it can be toggled
                 off from the ⚙ column menu (Odoo doesn't make it optional by default, so it
                 never appears there). Stays visible by default + available in Studio; the
                 stacked "Customer Details" column below is the richer alternative. -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <!-- Order Number. Core ships it optional="hide" (pos_order_view.xml), and a
                 hidden optional column is absent from Studio entirely - it cannot be
                 positioned or switched on there, only from the gear menu. Flipped to
                 "show" so it is a column Studio can place. This is the Order # the
                 counter calls out and the one the receipt prints as "ORDER # "; it is
                 NOT pos_reference, which is the Receipt Number. -->
            <xpath expr="//field[@name='tracking_number']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <!-- Tag the list so we can wrap the column headers (scss) without affecting
                 other backend lists. -->
            <xpath expr="//list" position="attributes">
                <attribute name="class" add="laundry-orders-list" separator=" "/>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="laundry_customer_block" optional="show" widget="laundry_customer_block"/>
                <field name="laundry_service_type" optional="show"/>
                <field name="laundry_secondary_type" optional="show"/>
                <!-- One service per line (laundry_services is comma-joined). A plain
                     Char here would be clipped by the cell's ellipsis the moment an
                     order has more than one. -->
                <field name="laundry_services" string="Services" optional="show" widget="laundry_services_list"/>
                <!-- Staff / processed date / status for EVERY service on the order, in
                     one cell, one line per service. Tapping a line opens the PIN wizard
                     on that service - this is where progress is now recorded. -->
                <field name="laundry_service_block" optional="show" widget="laundry_service_block"/>
                <field name="laundry_due_datetime" optional="show"/>
                <field name="laundry_due_icon" optional="show"/>
                <!-- The three Wash-Dry-Fold columns: READ-ONLY mirrors of the order's
                     Wash-Dry-Fold row in the Services Progress column (the mirror is
                     one-way, see laundry_order_service._mirror_wdf_to_order). Editable
                     here they would be a second place to state the same fact, and the two
                     could disagree. Kept so the WDF numbers stay sortable, exportable and
                     placeable in Studio, and so laundry_account_reports keeps its cashier. -->
                <field name="laundry_status" optional="show" readonly="1"/>
                <field name="laundry_staff_id" optional="show" readonly="1"/>
                <field name="laundry_processed_datetime" optional="show" readonly="1"/>
                <field name="laundry_pickup_rider" optional="show"/>
                <field name="laundry_delivery_rider" optional="show"/>
                <field name="laundry_account_approved_by" optional="show"/>
                <field name="laundry_refund_rebook_ref" optional="show"/>
                <field name="laundry_refund_manager" optional="show"/>
                <field name="laundry_refund_reason" optional="show"/>
            </xpath>
            <!-- Pastel row fill by due-urgency is applied in JS (backend/due_rows.js patches
                 ListRenderer.getRowClass off the visible laundry_due_icon) + styled in
                 backend/due_rows.scss. Odoo's native decoration-* only colours text and was
                 unreliable on this Studio-customised editable list, so we do it directly. -->
        </field>
    </record>

    <!--
        POS Orders FORM: add the laundry workflow fields (editing happens here now).
        Anchored on the core partner_id field of the base form so it validates. Status /
        Service Type / Due Datetime are read-only; Staff (employee) and Folding Time editable.
    -->
    <record id="view_pos_order_form_laundry" model="ir.ui.view">
        <field name="name">pos.order.form.laundry</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="laundry_service_type" readonly="1"/>
                <field name="laundry_due_datetime" readonly="1"/>
                <!-- Wash-Dry-Fold mirror (read-only - record progress on the Services
                     list below, or on the Services Progress column of the order list). -->
                <field name="laundry_status" readonly="1"/>
                <field name="laundry_staff_id" readonly="1"/>
                <field name="laundry_processed_datetime" readonly="1"/>
                <field name="laundry_all_done" readonly="1"/>
                <!-- Every service, so one order can be read on its own page. Read-only on
                     purpose: a change here would skip the PIN, and the PIN is how the
                     module records WHO did the work. -->
                <field name="laundry_service_ids" readonly="1" nolabel="1" colspan="2">
                    <list create="false" delete="false">
                        <field name="sequence" column_invisible="1"/>
                        <field name="name"/>
                        <field name="staff_id"/>
                        <field name="processed_datetime"/>
                        <field name="status"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- PIN-gated wizard to set Staff / Processed Date (the assigned cashier's PIN). -->
    <record id="view_laundry_staff_pin_wizard_form" model="ir.ui.view">
        <field name="name">laundry.staff.pin.wizard.form</field>
        <field name="model">laundry.staff.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Staff / Processed Date">
                <group>
                    <field name="order_id" invisible="1"/>
                    <!-- Which service this PIN signs for - shown so nobody signs off
                         the wrong one on a multi-service order. The id is carried
                         invisibly (a readonly field would not be saved); the name is a
                         related field and is display-only. -->
                    <field name="service_id" invisible="1"/>
                    <field name="service_name" invisible="not service_id"/>
                    <field name="staff_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="processed_datetime" widget="laundry_folding_roller"/>
                    <field name="pin" password="True" placeholder="Cashier PIN"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
