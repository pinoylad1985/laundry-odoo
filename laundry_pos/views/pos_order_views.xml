<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        POS Orders LIST: append the laundry_* columns (display only — editing is done on
        the form). We can't hide the Studio x_studio_* columns from a module view
        (xpath-targeting Studio-added columns fails validation) — hide them via the ⚙
        column picker or the Studio view.
    -->
    <record id="view_pos_order_tree_laundry" model="ir.ui.view">
        <field name="name">pos.order.list.laundry</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <!-- Make the core "Customer" column (partner_id) optional so it can be toggled
                 off from the ⚙ column menu (Odoo doesn't make it optional by default, so it
                 never appears there). Stays visible by default + available in Studio; the
                 stacked "Customer Details" column below is the richer alternative. -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <!-- Order Number. Core ships it optional="hide" (pos_order_view.xml), and a
                 hidden optional column is absent from Studio entirely - it cannot be
                 positioned or switched on there, only from the gear menu. Flipped to
                 "show" so it is a column Studio can place. This is the Order # the
                 counter calls out and the one the receipt prints as "ORDER # "; it is
                 NOT pos_reference, which is the Receipt Number. -->
            <xpath expr="//field[@name='tracking_number']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <!-- Tag the list so we can wrap the column headers (scss) without affecting
                 other backend lists. -->
            <xpath expr="//list" position="attributes">
                <attribute name="class" add="laundry-orders-list" separator=" "/>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="laundry_customer_block" optional="show" widget="laundry_customer_block"/>
                <!-- "TAT", not the field's own "Turnaround (TAT)": the column is read
                     down a long list and the header is the widest thing in it. The pill
                     (REG blue / EXP red) is laundry_tat_pill - see
                     static/src/backend/tat_pill_field.js. -->
                <field name="laundry_turnaround" string="TAT" optional="show" widget="laundry_tat_pill"/>
                <field name="laundry_service_type" optional="show"/>
                <field name="laundry_secondary_type" optional="show"/>
                <!-- One service per line (laundry_services is comma-joined). A plain
                     Char here would be clipped by the cell's ellipsis the moment an
                     order has more than one. -->
                <field name="laundry_services" string="Services" optional="show" widget="laundry_services_list"/>
                <!-- The services, their staff, their dates and their statuses are all
                     carried to the cells by this ONE hidden value (JSON). No column of
                     its own: the three columns below do the showing. -->
                <field name="laundry_service_block" column_invisible="1"/>
                <field name="laundry_due_datetime" optional="show"/>
                <field name="laundry_due_icon" optional="show"/>
                <!-- The SAME three columns the list always had - Status, Staff, Processed
                     Date - now with one line per service inside each cell, in the same
                     order in all three (and in the same order as the Services column), so
                     the row still reads across. One order stays ONE row.
                     Tapping a line opens the PIN wizard on THAT service: progress is
                     recorded where it is read. An order with no service rows (anything
                     predating this) falls back to the order's own single value.
                     readonly: the values are never typed into the cell, they are signed
                     for with a PIN. -->
                <field name="laundry_status" optional="show" readonly="1" widget="laundry_service_status"/>
                <field name="laundry_staff_id" optional="show" readonly="1" widget="laundry_service_staff"/>
                <field name="laundry_processed_datetime" optional="show" readonly="1" widget="laundry_service_processed"/>
                <field name="laundry_pickup_rider" optional="show"/>
                <field name="laundry_delivery_rider" optional="show"/>
                <field name="laundry_account_approved_by" optional="show"/>
                <field name="laundry_refund_rebook_ref" optional="show"/>
                <field name="laundry_refund_manager" optional="show"/>
                <field name="laundry_refund_reason" optional="show"/>
            </xpath>
            <!-- Pastel row fill by due-urgency is applied in JS (backend/due_rows.js patches
                 ListRenderer.getRowClass off the visible laundry_due_icon) + styled in
                 backend/due_rows.scss. Odoo's native decoration-* only colours text and was
                 unreliable on this Studio-customised editable list, so we do it directly. -->
        </field>
    </record>

    <!--
        POS Orders FORM: add the laundry workflow fields (editing happens here now).
        Anchored on the core partner_id field of the base form so it validates. Status /
        Service Type / Due Datetime are read-only; Staff (employee) and Folding Time editable.
    -->
    <record id="view_pos_order_form_laundry" model="ir.ui.view">
        <field name="name">pos.order.form.laundry</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="laundry_service_type" readonly="1"/>
                <field name="laundry_due_datetime" readonly="1"/>
                <!-- Wash-Dry-Fold mirror (read-only - record progress in the Services
                     list below, or in the Status / Staff / Processed Date columns of the
                     order list). laundry_selection_text rather than the plain field: see
                     that widget for why a readonly selection is a crash risk on order
                     history that carries statuses no longer offered. -->
                <field name="laundry_status" readonly="1" widget="laundry_selection_text"/>
                <!-- no_open: a readonly Many2one is still a link into the employee
                     record, and the POS PIN lives on that form. Nobody needs to walk
                     from an order into an employee file. -->
                <field name="laundry_staff_id" readonly="1" options="{'no_open': True}"/>
                <field name="laundry_processed_datetime" readonly="1"/>
                <!-- Orders that predate per-service tracking have no rows to press, so
                     the old order-level path stays reachable for exactly those. -->
                <button name="action_laundry_set_staff" type="object" class="btn-link ps-0"
                        string="Set Staff / Processed Date"
                        invisible="laundry_service_ids"/>
                <field name="laundry_all_done" readonly="1"/>
                <!-- Every service, so a multi-service order is signed off from the page
                     that shows all of them. The VALUES are read-only - typing a staff
                     name straight onto the row would skip the PIN, and the PIN is how
                     the module records WHO did the work - so each row carries a button
                     that opens the same PIN wizard the order list's cells open. -->
                <field name="laundry_service_ids" readonly="1" nolabel="1" colspan="2">
                    <list create="false" delete="false">
                        <field name="sequence" column_invisible="1"/>
                        <field name="name"/>
                        <field name="staff_id" options="{'no_open': True}"/>
                        <field name="processed_datetime"/>
                        <field name="status" widget="laundry_selection_text"/>
                        <button name="action_laundry_set_staff" type="object"
                                class="btn-link" string="Set Staff / Date"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- PIN-gated wizard to set Staff / Processed Date (the assigned cashier's PIN). -->
    <record id="view_laundry_staff_pin_wizard_form" model="ir.ui.view">
        <field name="name">laundry.staff.pin.wizard.form</field>
        <field name="model">laundry.staff.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Staff / Processed Date">
                <group>
                    <field name="order_id" invisible="1"/>
                    <!-- Which service this PIN signs for - shown so nobody signs off
                         the wrong one on a multi-service order. The id is carried
                         invisibly (a readonly field would not be saved); the name is a
                         related field and is display-only. -->
                    <field name="service_id" invisible="1"/>
                    <field name="service_name" invisible="not service_id"/>
                    <!-- list_view_ref: "Search more..." must NOT open the default
                         employee list, which carries the POS PIN column. no_open so the
                         employee record cannot be opened from here either. -->
                    <field name="staff_id"
                           options="{'no_create': True, 'no_open': True}"
                           context="{'list_view_ref': 'laundry_pos.view_employee_list_laundry_picker'}"/>
                    <field name="processed_datetime" widget="laundry_folding_roller"/>
                    <field name="pin" password="True" placeholder="Cashier PIN"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
