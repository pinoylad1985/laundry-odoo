<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Express Price" sits right next to "Extra Price" everywhere an attribute
         value's price is edited: the list opened from the product's Attributes tab
         (the ⚙ / Configure button on an attribute line) and that value's form. -->

    <record id="product_template_attribute_value_view_tree_express" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.laundry.express</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="laundry_express_price" widget="monetary" options="{'field_digits': True}"/>
            </field>
        </field>
    </record>

    <record id="product_template_attribute_value_view_form_express" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.laundry.express</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="laundry_express_price" widget="monetary" options="{'field_digits': True}"/>
            </field>
        </field>
    </record>

</odoo>
