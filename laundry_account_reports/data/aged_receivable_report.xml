<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Adds an "Address" column to Accounting > Reporting > Aged Receivable.

        The column deliberately has NO matching account.report.expression on
        aged_receivable_line. Odoo builds one cell per entry in options['columns'],
        so a column without an expression still gets a properly aligned (blank)
        cell on every row; the value is filled in afterwards by
        _custom_line_postprocessor. Going through an expression instead would mean
        threading the address through the SQL engine AND the unfold-all batch
        generator, for a value that only ever applies to partner rows.

        sequence=0 puts it first, right after the partner name (the stock columns
        are auto-sequenced from 1). Raise it to reposition, e.g. 12 to put the
        address last, after Total.
    -->
    <record id="aged_receivable_report_partner_address" model="account.report.column">
        <field name="report_id" ref="account_reports.aged_receivable_report"/>
        <field name="name">Address</field>
        <field name="expression_label">partner_address</field>
        <field name="figure_type">string</field>
        <field name="sequence">0</field>
        <field name="sortable" eval="True"/>
    </record>
</odoo>
