<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">

        <!-- "Service Type: Locker | LX-000123" - appended INSIDE laundry_pos's
             own service-type line, so the ref keeps the one piece of context
             that makes sense of it and never prints on an order that has none. -->
        <xpath expr="//div[hasclass('laundry-service-type')]" position="inside">
            <t t-if="laundryLockerRef">
                <span> | </span>
                <span class="laundry-detail-ref" t-esc="laundryLockerRef"/>
            </t>
        </xpath>

    </t>
</templates>
