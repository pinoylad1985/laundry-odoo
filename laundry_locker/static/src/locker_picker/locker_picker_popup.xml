<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- A contact in three lines - name, then phone, then address - the way
         the POS Orders list prints one (laundry_customer_block). Used for the
         customer the number MATCHED: that is a record in the book, and WHICH
         record it is is not something the columns above can say.

         The contact a confirmation is about to CREATE no longer uses this. Its
         name and phone are what the columns already show, and printing them
         again under a heading of their own read as a second, possibly
         different answer (v1.1.20) - so only the part the columns do NOT
         carry, the address, is previewed there.

         The lines come from the server (res.partner._laundry_contact_block in
         laundry_pos), so the register, the contact form and the Orders list
         cannot describe one customer three ways. -->
    <t t-name="laundry_locker.ContactBlock">
        <div t-foreach="lines" t-as="line" t-key="line_index"
             t-att-class="line_index == 0 ? 'fs-4 fw-bold' : 'text-muted'">
            <t t-esc="line"/>
        </div>
    </t>

    <!-- The twelve columns, written ONCE.

         Step 2 shows the chosen drop-off as a row of the same table rather
         than as a strip of labelled values (v1.1.20): a cashier matching
         paper to a bag has just read the queue ACROSS, and the detail should
         be that same reading - same columns, same order, same widths - or
         every value has to be found again in a shape they have not seen. It
         also stops the two from drifting apart as columns are added. -->
    <t t-name="laundry_locker.RowHeadings">
        <thead>
            <tr>
                <th>Location</th>
                <th>Ref #</th>
                <th>New Laundry</th>
                <th>Customer</th>
                <!-- Two phone columns, side by side. Phone is the number the
                     CUSTOMER keyed in at the locker and it is never
                     overwritten here: it is what is printed on their drop-off
                     and what they will quote when they ring up about it.
                     Phone (Corrected) is the shop's note against it - the
                     number the register found actually answers. Shown as a
                     pair because a correction is only readable next to what
                     it corrected; one column holding "whichever is current"
                     cannot say that anything was changed at all. -->
                <th>Phone</th>
                <th>Phone (Corrected)</th>
                <th>Service</th>
                <th>Turnaround</th>
                <th>Pickup</th>
                <th>Delivery</th>
                <th>Dirty Door</th>
                <th>Status</th>
                <th>Customer Match</th>
            </tr>
        </thead>
    </t>

    <t t-name="laundry_locker.LockerPickerPopup">
        <Dialog title="'Locker Drop-offs'" size="'xl'" contentClass="'laundry-touch laundry-locker-picker'">
            <!-- Step 1: pick the drop-off -->
            <div t-if="!selectedRow">
                <input type="text" class="form-control form-control-lg mb-2"
                       placeholder="Search ref, customer, phone, location…"
                       t-att-value="state.query"
                       t-on-input="(ev) => this.state.query = ev.target.value"/>
                <div t-if="!state.rows.length" class="text-muted p-3 text-center">
                    No unbilled locker transactions.
                </div>
                <div t-else="" class="laundry-locker-rows">
                    <table class="table table-sm align-middle mb-0">
                        <t t-call="laundry_locker.RowHeadings"/>
                        <tbody>
                            <tr t-foreach="filteredRows" t-as="row" t-key="row.id"
                                class="laundry-locker-row"
                                t-on-click="() => this.selectRow(row)">
                                <td><t t-esc="row.location_name"/></td>
                                <td class="fw-bold"><t t-esc="row.ref"/></td>
                                <td class="text-nowrap"><t t-esc="row.new_laundry_at"/></td>
                                <td><t t-esc="row.customer_name"/></td>
                                <td><t t-esc="row.phone_source"/></td>
                                <td>
                                    <t t-if="row.phone_corrected">
                                        <t t-esc="row.phone_corrected"/>
                                    </t>
                                    <span t-else="" class="text-muted">&#8212;</span>
                                </td>
                                <td><t t-esc="row.service"/></td>
                                <td><t t-esc="row.turnaround"/></td>
                                <td class="text-nowrap"><t t-esc="row.pickup_datetime"/></td>
                                <td class="text-nowrap"><t t-esc="row.delivery_datetime"/></td>
                                <td><t t-esc="row.dirty_door"/></td>
                                <td><t t-esc="row.status_label"/></td>
                                <td>
                                    <span class="badge" t-att-class="matchClass(row.customer_match)">
                                        <t t-esc="matchLabel(row.customer_match)"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div t-if="!filteredRows.length" class="text-muted p-3 text-center">
                        Nothing matches that search.
                    </div>
                </div>
            </div>

            <!-- Step 2: confirm the customer on the chosen drop-off -->
            <div t-else="" class="laundry-locker-detail">
                <!-- Customer, Phone and Customer Match come off the STATE,
                     not the row: those three are the ones a correction
                     changes, and this cell is the only place they are shown
                     now, so it has to follow the correction as it is made.
                     The rest is the drop-off as the feed sent it. -->
                <div class="laundry-locker-rows mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <t t-call="laundry_locker.RowHeadings"/>
                        <tbody>
                            <tr class="laundry-locker-chosen">
                                <td><t t-esc="selectedRow.location_name"/></td>
                                <td class="fw-bold"><t t-esc="selectedRow.ref"/></td>
                                <td class="text-nowrap"><t t-esc="selectedRow.new_laundry_at"/></td>
                                <td><t t-esc="state.customerName"/></td>
                                <!-- The locker's own number, off the ROW:
                                     correcting a number does not change what
                                     the customer typed, and this column is
                                     the only place that still says it. -->
                                <td><t t-esc="selectedRow.phone_source"/></td>
                                <!-- Off the STATE, so it fills in as the
                                     correction is typed rather than after it
                                     is saved. -->
                                <td>
                                    <t t-if="correctedPhone">
                                        <t t-esc="correctedPhone"/>
                                    </t>
                                    <span t-else="" class="text-muted">&#8212;</span>
                                </td>
                                <td><t t-esc="selectedRow.service"/></td>
                                <td><t t-esc="selectedRow.turnaround"/></td>
                                <td class="text-nowrap"><t t-esc="selectedRow.pickup_datetime"/></td>
                                <td class="text-nowrap"><t t-esc="selectedRow.delivery_datetime"/></td>
                                <td><t t-esc="selectedRow.dirty_door"/></td>
                                <td><t t-esc="selectedRow.status_label"/></td>
                                <td>
                                    <!-- An em-dash while the number is being
                                         corrected: there is no lookup result
                                         to report, and the badge earned by the
                                         number BEFORE the correction would be
                                         an answer about a different number. -->
                                    <span t-if="state.match" class="badge"
                                          t-att-class="matchClass(state.match)">
                                        <t t-esc="matchLabel(state.match)"/>
                                    </span>
                                    <span t-else="" class="text-muted">&#8212;</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- One block, three states: correcting, matched, unmatched.
                     The fields exist only in the first, which is reachable only
                     by answering that the number did not ring. -->
                <div class="p-3 border rounded-3 laundry-locker-customer">
                    <t t-if="canEditCustomer">
                        <div class="fw-bold mb-2">Correct the customer's details</div>
                        <div class="mb-2">
                            <label class="form-label mb-1">Customer name</label>
                            <input type="text" class="form-control form-control-lg"
                                   t-att-value="state.customerName"
                                   t-on-input="(ev) => this.state.customerName = ev.target.value"/>
                        </div>
                        <div>
                            <label class="form-label mb-1">Phone number</label>
                            <div class="d-flex gap-2">
                                <input type="tel" inputmode="tel"
                                       class="form-control form-control-lg"
                                       t-att-value="state.phone"
                                       t-on-input="onPhoneInput"/>
                                <button class="btn btn-primary" t-on-click="checkPhone"
                                        t-att-disabled="state.checking">Check</button>
                            </div>
                            <small class="text-muted d-block mt-1">
                                Ask the customer for the number they actually answer
                                on, put it in and press Check.
                            </small>
                        </div>
                    </t>

                    <t t-elif="isReturning">
                        <!-- The Returning badge was here until v1.1.20 and is
                             now the Customer Match column. What stays is the
                             record itself: the columns say the number is
                             known, not WHOSE it is. -->
                        <div class="fw-bold mb-1">The customer in the book</div>
                        <div class="mt-1">
                            <t t-set="lines" t-value="returningLines"/>
                            <t t-call="laundry_locker.ContactBlock"/>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Matched on the last 10 digits — the drop-off was keyed in
                            as “<t t-esc="state.customerName"/>”.
                        </small>
                    </t>

                    <t t-else="">
                        <small class="text-muted d-block">
                            No customer has this number yet — a contact will be created.
                        </small>

                        <!-- The gate on creating a contact: a number nobody
                             answered would be saved against the customer
                             permanently.

                             The two buttons are the two ANSWERS to one question
                             - did it ring? - and not an answer beside an action.
                             "Wrong number - correct it" was the second one until
                             v1.1.15, and it read as a different kind of choice
                             from "I called it and it rang": one reports what
                             happened, the other announces a repair. A cashier
                             who had just dialed a dead number had to work out
                             for themselves that "wrong number" was where that
                             belonged. Phrased as a pair, the step is to press
                             what happened, and the correction is what the "did
                             not ring" answer LEADS TO rather than something to
                             be chosen instead. -->
                        <div class="fw-bold mt-3">
                            Step 1 - Call <t t-esc="state.phone"/>.
                        </div>
                        <div class="fw-bold mt-1 mb-2">Step 2 - Press what happened:</div>
                        <div class="d-flex gap-2">
                            <button class="btn flex-fill"
                                    t-att-class="state.verified ? 'btn-success' : 'btn-outline-success'"
                                    t-on-click="onPhoneRang">
                                <i class="fa fa-phone me-1"/>I called it and it rang
                            </button>
                            <button class="btn btn-outline-danger flex-fill"
                                    t-on-click="onPhoneWrong">
                                <i class="fa fa-ban me-1"/>I called it and it did NOT ring
                            </button>
                        </div>
                        <!-- Said once the answer is in, because the button
                             turning solid is a color change on a screen the
                             cashier has stopped reading - it does not say what
                             to do next.

                             It names what Confirm is about to DO, because what
                             it does is not undoable from here: a contact gets
                             created, and it is the mis-tap on the button above
                             that this sentence is meant to catch, at the one
                             moment the cashier is still looking. -->
                        <div t-if="state.verified" class="text-success mt-2">
                            <i class="fa fa-check me-1"/>Number confirmed. Confirm will
                            create this new contact, at this address:
                            <div t-if="newContactAddressLines.length" class="mt-1 text-body">
                                <div t-foreach="newContactAddressLines" t-as="line"
                                     t-key="line_index">
                                    <t t-esc="line"/>
                                </div>
                            </div>
                            <!-- Said here rather than found out later: every
                                 service type needs an address on the contact,
                                 and this is the one drop-off that cannot
                                 supply one. -->
                            <div t-else="" class="mt-1 text-danger">
                                This drop-off carries no locker site, so the contact
                                gets no address. Add one on the contact before the
                                order can be taken.
                            </div>

                            <!-- A tag on the contact, chosen here, because a
                                 locker bag is handed to a machine rather than
                                 to a cashier: the tag is the only thing on the
                                 order that says what kind of customer left it,
                                 and it is the one thing a Locker order asks of
                                 a contact that the drop-off itself cannot
                                 supply (contact_requirements.js in
                                 laundry_pos). Asked at the moment the contact
                                 is created, which is the only moment the
                                 picker has. -->
                            <!-- The tags box is the one from the contact
                                 form: chips inside a field, a caret, and a
                                 list that narrows as you type. A row of
                                 buttons was the first shape (v1.1.20) and it
                                 is not what a tag looks like anywhere else in
                                 Odoo - the cashier should be picking the same
                                 control here as on the contact itself. -->
                            <div t-if="state.tags.length" class="mt-3 text-body laundry-locker-tags">
                                <label class="form-label fw-bold mb-1">Tags</label>
                                <div class="laundry-tag-box form-control"
                                     t-on-click="focusTagInput">
                                    <span t-foreach="selectedTags" t-as="tag" t-key="tag.id"
                                          class="laundry-tag">
                                        <t t-esc="tag.name"/>
                                        <i class="fa fa-times ms-2"
                                           t-on-click.stop="() => this.removeTag(tag.id)"/>
                                    </span>
                                    <input type="text" class="laundry-tag-input"
                                           t-ref="tagInput"
                                           placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, …"
                                           t-att-value="state.tagQuery"
                                           t-on-input="onTagInput"
                                           t-on-keydown="onTagKeydown"
                                           t-on-focus="() => this.state.tagOpen = true"
                                           t-on-blur="onTagBlur"/>
                                    <i class="fa fa-caret-down laundry-tag-caret"/>
                                </div>
                                <div t-if="state.tagOpen" class="laundry-tag-menu">
                                    <div t-foreach="tagChoices" t-as="tag" t-key="tag.id"
                                         class="laundry-tag-option"
                                         t-on-mousedown.prevent="() => this.pickTag(tag.id)">
                                        <t t-esc="tag.name"/>
                                    </div>
                                    <div t-if="!tagChoices.length" class="laundry-tag-option text-muted">
                                        No tag matches that.
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-1">
                                    Pick at least one — a Locker order needs one.
                                </small>
                            </div>
                        </div>
                    </t>
                </div>

                <div t-if="state.error" class="text-danger mt-2"><t t-esc="state.error"/></div>
            </div>

            <t t-set-slot="footer">
                <button t-if="selectedRow" class="btn btn-primary"
                        t-att-disabled="confirmDisabled" t-on-click="confirm">Confirm</button>
                <button t-if="selectedRow" class="btn btn-secondary" t-on-click="back">Back</button>
                <!-- The only way out of the queue, and it is not a way past
                     it: leaving without a drop-off puts the service type back
                     to what it was, so a Locker order is always one that came
                     off a row here. Named for where it lands the cashier,
                     because "Cancel" read like cancelling the order. -->
                <button t-if="!selectedRow" class="btn btn-secondary"
                        t-on-click="() => this.props.close()">Back to service type</button>
            </t>
        </Dialog>
    </t>
</templates>
