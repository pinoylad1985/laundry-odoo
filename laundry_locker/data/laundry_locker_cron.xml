<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            The safety net behind the push: catches anything that arrived while
            Odoo was down, plus every later status change (the push only fires
            on a new drop-off). noupdate so an upgrade never resets a schedule
            or re-enables a cron someone turned off.
        -->
        <record id="ir_cron_laundry_locker_sync" model="ir.cron">
            <field name="name">Lockers: sync transactions from Firebase</field>
            <field name="model_id" ref="model_laundry_locker_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_locker_transactions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
