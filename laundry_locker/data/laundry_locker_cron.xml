<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            How the locker list is fed. It was written as the safety net behind
            the push - catching what arrived while Odoo was down, plus every
            later status change, since the push only fires on a new drop-off -
            but nothing upstream calls the push, so this is the only path in
            and its interval is the latency the counter actually sees.

            Every 5 minutes, to match pudopro_orders_sync.py writing /orders at
            that cadence: any longer and the till waits on a drop-off that is
            already in Firebase. The read is a delta (orderBy updatedAt,
            startAt the last watermark), so a run that finds nothing new costs
            one small request.

            noupdate so an upgrade never resets a schedule or re-enables a cron
            someone turned off. Which also means CHANGING THE INTERVAL HERE
            DOES NOTHING to a database where this cron already exists - only a
            fresh install reads it. Anywhere else it is Settings > Technical >
            Scheduled Actions.
        -->
        <record id="ir_cron_laundry_locker_sync" model="ir.cron">
            <field name="name">Lockers: sync transactions from Firebase</field>
            <field name="model_id" ref="model_laundry_locker_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_locker_transactions()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
