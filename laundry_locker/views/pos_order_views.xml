<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Where a drop-off came from, as ONE column on the POS Orders list: the
        ref, the site and the door stacked by the `laundry_locker_block` widget
        instead of three columns of their own. optional="show" so it is
        available in Studio and can be repositioned there (a hidden optional
        column never appears in Studio at all).
    -->
    <record id="view_pos_order_tree_locker" model="ir.ui.view">
        <field name="name">pos.order.list.locker</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="laundry_pos.view_pos_order_tree_laundry"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="laundry_locker_block" string="Locker Details" optional="show"
                       widget="laundry_locker_block"/>
            </xpath>
        </field>
    </record>
</odoo>
