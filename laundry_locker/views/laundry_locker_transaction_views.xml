<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        The locker list mirrors the LIST (locker) tab of dashboard.laundryx.app,
        trimmed to the columns the counter actually works from, plus the two
        Odoo adds: Billed, and whether the phone number matches a customer we
        already have.
    -->
    <record id="laundry_locker_transaction_view_list" model="ir.ui.view">
        <field name="name">laundry.locker.transaction.list</field>
        <field name="model">laundry.locker.transaction</field>
        <field name="arch" type="xml">
            <list string="Locker Transactions"
                  decoration-muted="billed"
                  decoration-warning="not billed and customer_match == 'new'"
                  create="0">
                <!-- The cron is the routine path; these are for when the
                     counter is waiting on a drop-off that just happened, or
                     when the sync has been taught a field the rows predate.
                     Both tooltipped, because which one to press is not
                     guessable from the labels and pressing the wrong one
                     looks like the sync is broken. -->
                <header>
                    <button name="action_sync_now" type="object" string="Sync now"
                            display="always" class="btn-secondary"
                            title="Reads only what has changed since the last sync, so it is quick. Use it when you are waiting on a drop-off that has just happened. This is what runs automatically every few minutes."/>
                    <!-- Re-reads everything: for backfilling a field added to
                         the mapping after the rows were already imported. -->
                    <button name="action_full_resync" type="object" string="Full resync"
                            display="always" class="btn-secondary"
                            title="Re-reads every locker transaction instead of only the recent ones, so it is slower. Use it after the sync has been taught something new - a drop-off door, say - to fill that in on rows that are already listed. Sync now will never revisit those on its own, because nothing has changed at the locker end. It is safe to run: it cannot overwrite a door already recorded, and it never touches Billed, the order it was sold on, or a phone number corrected at the till."/>
                </header>
                <field name="location_name" string="Location" optional="show"/>
                <field name="ref" string="Ref #" optional="show"/>
                <field name="new_laundry_at" string="New Laundry" optional="show"/>
                <field name="customer_name" string="Customer" optional="show"/>
                <field name="phone" string="Phone" optional="show"/>
                <field name="service" string="Service" optional="show"/>
                <field name="turnaround" string="Turnaround" optional="show"/>
                <field name="pickup_datetime" string="Pickup" optional="show"/>
                <field name="delivery_datetime" string="Delivery" optional="show"/>
                <field name="dirty_door" string="Dirty Door" optional="show"/>
                <field name="status_label" string="Status" optional="show"/>
                <field name="billed" string="Billed" widget="boolean_toggle" readonly="1" optional="show"/>
                <!-- Filled in when the drop-off is billed, and emptied again
                     if that sale is refunded. Order # is what the counter
                     calls out and is NOT unique - it restarts each session -
                     so Receipt # is here beside it for when one has to be
                     found for certain. -->
                <field name="pos_order_number" string="Order #" optional="show"/>
                <field name="pos_order_ref" string="Receipt #" optional="show"/>
                <field name="customer_match" string="Customer Match" widget="badge"
                       decoration-success="customer_match == 'returning'"
                       decoration-warning="customer_match == 'new'"
                       optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="phone_verified" optional="hide"/>
                <field name="pos_order_id" optional="hide"/>
                <field name="created_at" optional="hide"/>
                <field name="status_code" column_invisible="1"/>
                <!-- Reads PU, DL, both, or nothing at all. Placed just
                     before the two buttons that fill it in, so pressing one
                     and seeing the mark appear is a single glance. Blank is
                     the state that needs doing.

                     It says only that a task was MADE, not that it was ticked
                     off: whether it is done lives in Google, and asking on
                     every list render would be a request per row. -->
                <field name="google_task_set" string="Calendar" widget="badge"
                       decoration-success="google_task_set == 'PU DL'"
                       decoration-warning="google_task_set and google_task_set != 'PU DL'"
                       optional="show"/>
                <!-- Per row, not in the header: this is about ONE drop-off's
                     own times, and the counter presses it while looking at
                     that row. Distinct icons rather than labels because the
                     row is already wide - a calendar page for the pickup, a
                     van for the delivery.

                     Deliberately NOT hidden when the time is missing: a
                     hidden button reads as a broken one, and the field it
                     would have to test is an optional column that stops being
                     loaded the moment somebody hides it. Pressing it on a
                     drop-off with no such time says so instead. -->
                <button name="action_google_task_pickup" type="object"
                        icon="fa-calendar-plus-o"
                        title="Add this drop-off's PICKUP to Google Tasks, to be ticked off when it is done. It shows in the day's Tasks row in Google Calendar, as the half hour ENDING at the time the customer was promised. Pressing it again updates the same task - it will not make a second one. The promised time is also the first line of the task's notes, in case Google keeps only the date."/>
                <button name="action_google_task_delivery" type="object"
                        icon="fa-truck"
                        title="Add this drop-off's DELIVERY to Google Tasks, to be ticked off when it is done. It shows in the day's Tasks row in Google Calendar, as the half hour ENDING at the time the customer was promised. Pressing it again updates the same task - it will not make a second one. The promised time is also the first line of the task's notes, in case Google keeps only the date."/>
                <field name="google_pickup_task_id" optional="hide"/>
                <field name="google_delivery_task_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="laundry_locker_transaction_view_form" model="ir.ui.view">
        <field name="name">laundry.locker.transaction.form</field>
        <field name="model">laundry.locker.transaction</field>
        <field name="arch" type="xml">
            <!-- No header, on purpose. Everything a counter decides about a
                 drop-off is decided while the order is being taken: the number
                 is confirmed in the locker picker, the customer is matched
                 there or created there, and a drop-off is freed by REFUNDING
                 the sale that took it. A button here would be a second place
                 to do one of those, out of sight of the order it belongs to. -->
            <form string="Locker Transaction" create="0">
                <sheet>
                    <div class="oe_title">
                        <label for="ref" string="Ref #"/>
                        <h1><field name="ref" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <!-- Editable on purpose: a locker customer keys in their
                                 own number and sometimes mistypes it. Correcting it
                                 re-runs the Returning/New lookup. -->
                            <field name="phone"/>
                            <field name="phone_last10" readonly="1"/>
                            <field name="customer_match" widget="badge" readonly="1"/>
                            <field name="partner_id"/>
                            <!-- Set at the till, when a contact is created
                                 from this number - not tickable here. -->
                            <field name="phone_verified" readonly="1"/>
                        </group>
                        <group string="Locker">
                            <field name="location_name" readonly="1"/>
                            <field name="location_code" readonly="1"/>
                            <field name="dirty_door" readonly="1"/>
                            <field name="service" readonly="1"/>
                            <field name="turnaround" readonly="1"/>
                            <!-- What the customer picked at the locker; the
                                 till carries it into the order's schedule. -->
                            <field name="pickup_datetime" readonly="1"/>
                            <field name="delivery_datetime" readonly="1"/>
                            <field name="status_label" readonly="1"/>
                            <field name="status_code" readonly="1"/>
                        </group>
                        <group string="Billing">
                            <field name="billed" readonly="1"/>
                            <field name="pos_order_id" readonly="1"/>
                            <field name="pos_order_number" readonly="1"/>
                            <field name="pos_order_ref" readonly="1"/>
                            <field name="billed_date" readonly="1"/>
                        </group>
                        <!-- Buttons here despite the note above, because
                             making a task decides nothing about the drop-off:
                             it copies out a schedule the feed already gave, and
                             pressing it twice changes the same task. The task
                             refs sit with them so it is visible whether this
                             row has been put on the list at all. -->
                        <group string="Google Tasks">
                            <div colspan="2" class="mb-2">
                                <button name="action_google_task_pickup"
                                        type="object" class="btn-secondary me-2"
                                        icon="fa-calendar-plus-o" string="Pickup"
                                        title="Add this drop-off's pickup to Google Tasks."/>
                                <button name="action_google_task_delivery"
                                        type="object" class="btn-secondary"
                                        icon="fa-truck" string="Delivery"
                                        title="Add this drop-off's delivery to Google Tasks."/>
                            </div>
                            <field name="google_task_set" readonly="1"/>
                            <field name="google_pickup_task_id" readonly="1"/>
                            <field name="google_delivery_task_id" readonly="1"/>
                        </group>
                        <group string="Sync">
                            <field name="new_laundry_at" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                            <field name="updated_at" readonly="1"/>
                            <field name="synced_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="laundry_locker_transaction_view_search" model="ir.ui.view">
        <field name="name">laundry.locker.transaction.search</field>
        <field name="model">laundry.locker.transaction</field>
        <field name="arch" type="xml">
            <search string="Locker Transactions">
                <field name="ref" string="Ref #"/>
                <field name="customer_name" string="Customer"/>
                <!-- Search the raw number OR the last-10 form, so 0917... and
                     917... both find the row. -->
                <field name="phone" string="Phone"
                       filter_domain="['|', ('phone', 'ilike', self), ('phone_last10', 'ilike', self)]"/>
                <field name="location_name" string="Location"/>
                <!-- Both, under one box: a counter holding a receipt does not
                     stop to work out which of the two numbers it is. -->
                <field name="pos_order_number" string="Order / Receipt #"
                       filter_domain="['|', ('pos_order_number', 'ilike', self), ('pos_order_ref', 'ilike', self)]"/>
                <filter name="filter_unbilled" string="Unbilled"
                        domain="[('billed', '=', False)]"/>
                <filter name="filter_billed" string="Billed"
                        domain="[('billed', '=', True)]"/>
                <separator/>
                <filter name="filter_returning" string="Returning"
                        domain="[('customer_match', '=', 'returning')]"/>
                <filter name="filter_new" string="New"
                        domain="[('customer_match', '=', 'new')]"/>
                <separator/>
                <filter name="filter_unverified" string="Number Not Verified"
                        domain="[('phone_verified', '=', False)]"/>
                <separator/>
                <!-- Either one missing counts: a drop-off whose pickup is on
                     the list and whose delivery is not is exactly the one worth
                     finding again. -->
                <filter name="filter_not_on_calendar" string="Not On Calendar"
                        domain="['|', ('google_pickup_task_id', '=', False),
                                      ('google_delivery_task_id', '=', False)]"/>
                <separator/>
                <!-- Odoo 19 dropped the <group expand=...> wrapper from search
                     views; a group_by filter stands on its own and the UI still
                     files it under Group By. -->
                <filter name="group_location" string="Location"
                        context="{'group_by': 'location_name'}"/>
                <filter name="group_status" string="Status"
                        context="{'group_by': 'status_label'}"/>
                <filter name="group_match" string="Customer Match"
                        context="{'group_by': 'customer_match'}"/>
                <filter name="group_billed" string="Billed"
                        context="{'group_by': 'billed'}"/>
            </search>
        </field>
    </record>

    <record id="laundry_locker_transaction_action" model="ir.actions.act_window">
        <field name="name">Locker Transactions</field>
        <field name="res_model">laundry.locker.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="laundry_locker_transaction_view_search"/>
        <!-- Opens on what the counter needs: the ones still to be billed. -->
        <field name="context">{'search_default_filter_unbilled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No locker transactions yet</p>
            <p>Transactions arrive from the PudoPro lockers — they are not created by hand.</p>
        </field>
    </record>
</odoo>
